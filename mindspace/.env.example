# PostgreSQL connection string
DATABASE_URL="postgresql://mindspace:mindspace@localhost:5432/mindspace?schema=public"

# Used for tests only (a separate, disposable database)
TEST_DATABASE_URL="postgresql://mindspace:mindspace@localhost:5432/mindspace_test?schema=public"

# Long random string (at least 32 chars). Signs session cookies and encrypts
# the AI API key stored in the database. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional AI provider defaults (any OpenAI-compatible API). These can also be
# configured from Settings. Keys are only ever used server-side.
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""

# Offline AI: folder holding downloaded GGUF model files (npm run ai:download)
MODELS_DIR="./models"
